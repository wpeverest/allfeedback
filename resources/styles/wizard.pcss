body.allfb-wizard-fullscreen,
html:has(body.allfb-wizard-fullscreen) {
	margin-top: 0 !important;
	padding-top: 0 !important;
}

body.allfb-wizard-fullscreen #wpadminbar { display: none !important; }
body.allfb-wizard-fullscreen #adminmenuback,
body.allfb-wizard-fullscreen #adminmenuwrap { display: none !important; }
body.allfb-wizard-fullscreen #wpcontent {
	margin-left: 0 !important;
	padding-left: 0 !important;
}
body.allfb-wizard-fullscreen #wpbody { padding-top: 0 !important; }
body.allfb-wizard-fullscreen #wpbody-content {
	padding-top: 0 !important;
	padding-bottom: 0 !important;
}
body.allfb-wizard-fullscreen #wpfooter { display: none !important; }
body.allfb-wizard-fullscreen #ALLFB-Admin-Root {
	min-height: 100vh;
	padding: 0 !important;
}
