/**
 * admin.pcss — Admin SPA styles
 *
 * Imported by resources/scripts/admin/index.tsx
 * All rules are scoped under #ALLFB-Admin-Root where possible
 * to prevent WordPress admin CSS from leaking in.
 */

@import './app.pcss';

/* ── WP admin page background ────────────────────────────────────── */
.toplevel_page_all-feedback {
	background: #f4f6f8;
}

/* ── Remove WP default content padding so our SPA fills edge-to-edge */
.toplevel_page_all-feedback #wpcontent {
	padding-left:  0 !important;
	padding-right: 0 !important;
}

/* ── Reset WP global link styles inside the React root ──────────── */
#ALLFB-Admin-Root a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

/* ── Override WP admin form styles leaking into shadcn inputs ────── */
#ALLFB-Admin-Root [data-slot='input'],
#ALLFB-Admin-Root [data-slot='textarea'],
#ALLFB-Admin-Root [data-slot='select-trigger'] {
	background-color: white;
	color:            inherit;
	border-color:     inherit;
	box-shadow:       none;
}

/* ── Fix WP styles leaking into Radix portals ────────────────────── */
[data-slot='popover-content'] a,
[data-slot='select-content'] a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

[data-slot='select-content'],
[data-slot='select-item'] {
	color:            inherit;
	background-color: white;
	box-shadow:       none;
}

[data-slot='select-item']:hover,
[data-slot='select-item'][data-highlighted] {
	background-color: var(--accent);
	color:            var(--accent-foreground);
	outline:          none;
}

/* ── Loading cursor while async operations run ───────────────────── */
body[data-wait] {
	cursor: wait !important;

	#ALLFB-Admin-Root {
		& button,
		& a,
		& [role='button'] {
			pointer-events: none;
		}
	}
}
