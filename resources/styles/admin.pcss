/**
 * admin.pcss — Admin SPA styles
 *
 * Imported by resources/scripts/admin/index.tsx.
 * All rules are scoped under #ALLFB-Admin-Root where possible
 * to prevent WordPress admin CSS from leaking in.
 */

@import './app.pcss';

/* ── Remove WP default content padding so our SPA fills edge-to-edge ─────── */
.toplevel_page_all-feedback #wpcontent,
[class*="_page_all-feedback"] #wpcontent {
	padding-left:  0 !important;
	padding-right: 0 !important;
}

/* ── Neutralise WP admin margins on the React mount point ────────────────── */
#ALLFB-Admin-Root {
	min-height: calc(100vh - var(--wp-admin--admin-bar--height, 32px));
}

/* ── Reset WP global link styles inside the React root ───────────────────── */
#ALLFB-Admin-Root a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

/* ── Override WP admin form styles leaking into shadcn inputs ────────────── */
#ALLFB-Admin-Root [data-slot='input'],
#ALLFB-Admin-Root [data-slot='textarea'],
#ALLFB-Admin-Root [data-slot='select-trigger'],
#ALLFB-Admin-Root input:not([type='checkbox']):not([type='radio']),
#ALLFB-Admin-Root select,
#ALLFB-Admin-Root textarea {
	background-color: var(--card);
	color:            var(--foreground);
	border-color:     var(--border);
	box-shadow:       none;
	font-size:        inherit;
	line-height:      inherit;
}

/* ── Fix WP styles leaking into Radix portals ────────────────────────────── */
[data-slot='popover-content'] a,
[data-slot='select-content'] a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

[data-slot='select-content'],
[data-slot='select-item'] {
	color:            var(--foreground);
	background-color: var(--card);
	box-shadow:       none;
}

[data-slot='select-item']:hover,
[data-slot='select-item'][data-highlighted] {
	background-color: var(--accent);
	color:            var(--accent-foreground);
	outline:          none;
}

/* ── Remove WP's default button styling inside the SPA ───────────────────── */
#ALLFB-Admin-Root button {
	border:      none;
	appearance:  none;
	margin:      0;
	cursor:      pointer;
}

/* ── Pointer cursor on select options ────────────────────────────────────── */
#ALLFB-Admin-Root select option {
	cursor: pointer;
}

/* ── Loading cursor while async operations run ───────────────────────────── */
body[data-wait] {
	cursor: wait !important;

	#ALLFB-Admin-Root {
		& button,
		& a,
		& [role='button'] {
			pointer-events: none;
		}
	}
}
