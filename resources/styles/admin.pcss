/**
 * admin.pcss — Admin SPA styles
 *
 * Imported by resources/scripts/admin/index.tsx.
 * All rules are scoped under #ALLFB-Admin-Root where possible
 * to prevent WordPress admin CSS from leaking in.
 */

@import './app.pcss';
@import './frontend.pcss';

/* ── Remove WP default content padding so our SPA fills edge-to-edge ─────── */
.toplevel_page_all-feedback #wpcontent,
[class*="_page_all-feedback"] #wpcontent {
	padding-left:  0 !important;
	padding-right: 0 !important;
}

/* ── Neutralise WP admin margins on the React mount point ────────────────── */
#ALLFB-Admin-Root {
	min-height: calc(100vh - var(--wp-admin--admin-bar--height, 32px));
}

/* ── Reset WP global link styles inside the React root ───────────────────── */
#ALLFB-Admin-Root a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

/* ── Focused inputs always use primary colour as border ──────────────────── */
/* Exclude allfb-* widget inputs so preview focus styles apply unmodified.   */
#ALLFB-Admin-Root input:not([type='checkbox']):not([type='radio']):not(.allfb-input):focus,
#ALLFB-Admin-Root select:focus,
#ALLFB-Admin-Root textarea:not(.allfb-textarea):focus,
#ALLFB-Admin-Root [data-slot='select-trigger']:focus,
#ALLFB-Admin-Root [data-slot='select-trigger']:focus-visible {
	border-color: var(--primary);
	outline:      none;
}

/* ── Override WP admin form styles leaking into shadcn inputs ────────────── */
/* Exclude allfb-* widget inputs so preview styles apply unmodified.         */
#ALLFB-Admin-Root [data-slot='input'],
#ALLFB-Admin-Root [data-slot='textarea'],
#ALLFB-Admin-Root [data-slot='select-trigger'],
#ALLFB-Admin-Root input:not([type='checkbox']):not([type='radio']):not(.allfb-input),
#ALLFB-Admin-Root select,
#ALLFB-Admin-Root textarea:not(.allfb-textarea) {
	box-sizing:       border-box;  /* WP admin can flip inputs back to content-box */
	background-color: var(--card);
	color:            var(--foreground);
	border:           1px solid var(--border);
	box-shadow:       none;
	font-size:        inherit;
	line-height:      1.5;
}

/* ── Fix WP styles leaking into Radix portals ────────────────────────────── */
[data-slot='popover-content'] a,
[data-slot='select-content'] a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

[data-slot='select-content'],
[data-slot='select-item'] {
	color:            var(--foreground);
	background-color: var(--card);
	box-shadow:       none;
}

[data-slot='select-item']:hover,
[data-slot='select-item'][data-highlighted] {
	background-color: var(--accent);
	color:            var(--accent-foreground);
	outline:          none;
}

/* ── Remove WP's default button styling inside the SPA ───────────────────── */
/* Exclude allfb-* widget buttons so preview styles apply unmodified.        */
/* Exclude [data-slot='select-trigger'] so Radix Select keeps its border.    */
#ALLFB-Admin-Root button:not(.allfb-btn):not(.allfb-star):not(.allfb-scale__btn):not(.allfb-panel__close):not(.allfb-launcher):not([data-slot='select-trigger']) {
	border:      none;
	appearance:  none;
	margin:      0;
	cursor:      pointer;
	font-size:   14px;
	line-height: 1;
}

/* ── Button size font sizes — mirrors CVA size tokens in button.tsx ────────── */
/* WP admin non-layered CSS beats Tailwind @layer utilities, so we re-apply   */
/* the same values here at higher specificity (1,2,0) > button rule (1,0,1).  */
/* Keep in sync with the `size` variants in button.tsx when those change.     */
#ALLFB-Admin-Root [data-slot='button'][data-size='xs']  { font-size: 12px; } /* text-xs    */
#ALLFB-Admin-Root [data-slot='button'][data-size='sm']  { font-size: 13px; } /* text-[13px] */
#ALLFB-Admin-Root [data-slot='button'][data-size='lg']  { font-size: 15px; } /* text-[15px] */
/* default / icon sizes → 14px from the base button rule above               */

/* ── Pointer cursor on select options ────────────────────────────────────── */
#ALLFB-Admin-Root select option {
	cursor: pointer;
}

/* ── Radix SelectTrigger focus styles ─────────────────────────────────────── */
/* SelectTrigger is excluded from the button reset above, so Tailwind's       */
/* border classes apply. Only focus-visible needs a non-layered override to   */
/* beat any WP admin :focus rules.                                            */
#ALLFB-Admin-Root [data-slot='select-trigger']:focus-visible {
	border-color: var(--primary);
	box-shadow:   0 0 0 1px var(--primary);
	outline:      none;
}

/* ── Builder root: establish 14 px font baseline ─────────────────────────── */
.allfb-builder {
	font-size:   14px;
	font-family: var(--font-sans);
	line-height: 1.5;
	color:       var(--foreground);
}

/* ── Builder form title (must come after the input + button reset rules) ──── */
/* Specificity (1,2,1) ties input reset → source-order wins (this rule is later). */
/* Specificity (1,1,1) > button reset (1,0,1) → strict win.                    */
#ALLFB-Admin-Root input.builder-title:not([type='radio']),
#ALLFB-Admin-Root button.builder-title {
	box-sizing:  border-box;
	font-size:   20px !important;
	font-weight: 600;
	line-height: 1.5;
	padding:     0.5rem 1rem;
	text-align:  left;
}

/* ── Section title — lock all sizing tokens so button and input match ──────── */
/* text-md (1.125rem) and font-semibold live in @layer utilities and lose to   */
/* non-layered rules; set them explicitly here so both states render the same. */
#ALLFB-Admin-Root input.section-title-input,
#ALLFB-Admin-Root button.section-title-btn {
	box-sizing:  border-box;
	font-size:   1rem;
	font-weight: 500;
	line-height: 1.5;
	padding:     0.5rem 0.875rem;
}

/* Section-title button hover — @layer hover utilities lose to non-layered CSS */
/* so we re-apply them here at the correct specificity level.                  */
#ALLFB-Admin-Root button.section-title-btn:hover {
	background-color: rgba(0, 0, 0, 0.04);
	border-color:     color-mix(in oklch, var(--border) 50%, transparent);
}

/* Give display-mode title buttons the same border box as their edit inputs    */
/* so total height and text position stay identical in both states.             */
#ALLFB-Admin-Root button.builder-title,
#ALLFB-Admin-Root button.section-title-btn {
	border: 1px solid transparent;
}

/* Lock builder / section title input backgrounds and borders against the       */
/* generic input reset above — Tailwind bg-transparent / border-border/70 are  */
/* in @layer utilities and lose to non-layered CSS, so we re-apply here.        */
#ALLFB-Admin-Root input.builder-title:not([type='radio']),
#ALLFB-Admin-Root input.section-title-input {
	box-sizing:       border-box;
	background-color: transparent;
	border:           1px solid color-mix(in oklch, var(--border) 70%, transparent);
	box-shadow:       none;
}

#ALLFB-Admin-Root input.builder-title:not([type='radio']):focus,
#ALLFB-Admin-Root input.section-title-input:focus {
	background-color: transparent;
	border-color:     color-mix(in oklch, var(--primary) 50%, transparent);
	box-shadow:       0 0 0 1px color-mix(in oklch, var(--primary) 10%, transparent);
}

/* ── Publish split button ─────────────────────────────────────────────────── */
.publish-split {
	gap: 0;
}

/* border-left separator between Publish and chevron (specificity > button reset) */
#ALLFB-Admin-Root .publish-split .publish-split__arrow {
	border-left: 1px solid oklch(1 0 0 / 0.2);
}

/* ── Field type icon chips (data-type colours) ────────────────────────────── */
.field-type-icon {
	display:         flex;
	align-items:     center;
	justify-content: center;
	flex-shrink:     0;
	border-radius:   var(--radius-sm);
}

.field-type-icon[data-type='short_text']  { background-color: #fef2f2; color: #f43f5e; }
.field-type-icon[data-type='long_text']   { background-color: #eff6ff; color: #3b82f6; }
.field-type-icon[data-type='radio']       { background-color: #f5f3ff; color: #8b5cf6; }
.field-type-icon[data-type='checkboxes']  { background-color: #f0fdf4; color: #22c55e; }
.field-type-icon[data-type='star_rating'] { background-color: #fffbeb; color: #f59e0b; }
.field-type-icon[data-type='scale']       { background-color: #ecfdf5; color: #10b981; }
.field-type-icon[data-type='nps']         { background-color: #fff1f2; color: #e11d48; }

/* ── Field type floating menu (positioned by @floating-ui/dom) ────────────── */
/* top/left are set via JS — visibility:hidden until positioned prevents flash */
.field-type-menu {
	position:   fixed;
	top:        0;
	left:       0;
	z-index:    100000;
	width:      248px;
	max-height: calc(100vh - 16px);
	overflow-y: auto;
}

/* ── Preview panel container (dynamic width via CSS custom property) ─────── */
.preview-panel-wrapper {
	width: var(--preview-width, 45vw);
}

/* ── Required field checkbox ──────────────────────────────────────────────── */
#ALLFB-Admin-Root input[type='checkbox'].field-required-checkbox {
	appearance:         none;
	-webkit-appearance: none;
	width:              14px;
	height:             14px;
	border:             1.5px solid oklch(0.820 0.006 247);
	border-radius:      3px;
	background:         #fff;
	cursor:             pointer;
	flex-shrink:        0;
	position:           relative;
	transition:         background 0.15s, border-color 0.15s;
}

#ALLFB-Admin-Root input[type='checkbox'].field-required-checkbox:checked {
	background:    oklch(0.580 0.238 277); /* --brand-500 */
	border-color:  oklch(0.580 0.238 277);
}

#ALLFB-Admin-Root input[type='checkbox'].field-required-checkbox:checked::after {
	content:      '';
	position:     absolute;
	left:         3px;
	top:          1px;
	width:        5px;
	height:       8px;
	border:       2px solid #fff;
	border-top:   none;
	border-left:  none;
	transform:    rotate(45deg);
}

#ALLFB-Admin-Root input[type='checkbox'].field-required-checkbox:focus-visible {
	outline:        2px solid oklch(0.580 0.238 277 / 0.4);
	outline-offset: 1px;
}

/* ── Table typography — mirrors text-sm / text-xs tokens in theme ───────── */
/* WP admin ships its own table CSS; these non-layered rules enforce tokens.  */
#ALLFB-Admin-Root table {
	font-size:   13px; /* text-sm  */
	line-height: 1.5;
}

#ALLFB-Admin-Root th {
	font-size:   11px; /* text-xs  */
	font-weight: 600;
	line-height: 1.5;
}

#ALLFB-Admin-Root td {
	font-size:   13px; /* text-sm  */
	line-height: 1.5;
}

/* ── Tiptap question editor ──────────────────────────────────────────────── */
/* Scope tightly to avoid WP admin global p/strong/em margin/style conflicts  */
#ALLFB-Admin-Root .question-editor-field .tiptap {
	font-size:   15px;
	font-weight: 400;
	color:       var(--foreground);
	outline:     none;
	min-height:  1.75rem;
	line-height: 1.5;
	padding:     0.4rem 0.625rem;
	cursor:      text;
	transition:  min-height 0.2s ease;
}

#ALLFB-Admin-Root .question-editor-field[data-focused='true'] .tiptap {
	min-height: 5rem;
}

/* Strip WP admin's default paragraph margin inside the editor */
#ALLFB-Admin-Root .question-editor-field .tiptap p {
	margin: 0;
}

/* Placeholder text (Tiptap adds .is-editor-empty + data-placeholder) */
#ALLFB-Admin-Root .question-editor-field .tiptap p.is-editor-empty:first-child::before {
	content:        attr(data-placeholder);
	float:          left;
	height:         0;
	pointer-events: none;
	color:          var(--muted-foreground);
	opacity:        0.40;
	font-weight:    400;
}

/* Bullet + ordered lists */
#ALLFB-Admin-Root .question-editor-field .tiptap ul {
	list-style-type: disc;
	padding-left:    1.25rem;
	margin:          0.25rem 0;
}

#ALLFB-Admin-Root .question-editor-field .tiptap ol {
	list-style-type: decimal;
	padding-left:    1.25rem;
	margin:          0.25rem 0;
}

#ALLFB-Admin-Root .question-editor-field .tiptap li {
	display:     list-item;
	margin:      0.125rem 0;
	line-height: 1.5;
}

/* Blockquote */
#ALLFB-Admin-Root .question-editor-field .tiptap blockquote {
	border-left:  2px solid var(--border);
	padding-left: 0.75rem;
	margin:       0.25rem 0;
	color:        color-mix(in oklch, var(--muted-foreground) 70%, transparent);
	font-style:   italic;
}

/* Inline code mark */
#ALLFB-Admin-Root .question-editor-field .tiptap code {
	background-color: var(--muted);
	border-radius:    3px;
	padding:          0.1em 0.35em;
	font-family:      ui-monospace, monospace;
	font-size:        0.875em;
	color:            var(--foreground);
}

/* Highlight mark */
#ALLFB-Admin-Root .question-editor-field .tiptap mark {
	background-color: oklch(0.958 0.110 85);  /* amber-100 */
	color:            oklch(0.430 0.110 55);   /* amber-800 */
	border-radius:    2px;
	padding:          0 2px;
}

/* ── Preview widget field label rich content ─────────────────────────────── */
#ALLFB-Admin-Root .field-preview-label p {
	margin: 0;
}

#ALLFB-Admin-Root .field-preview-label ul {
	list-style-type:     disc;
	list-style-position: outside;
	padding-left:        1.125rem;
	margin:              0.125rem 0;
}

#ALLFB-Admin-Root .field-preview-label ol {
	list-style-type:     decimal;
	list-style-position: outside;
	padding-left:        1.125rem;
	margin:              0.125rem 0;
}

#ALLFB-Admin-Root .field-preview-label li {
	display:     list-item;
	margin:      0;
	line-height: 1.5;
}

#ALLFB-Admin-Root .field-preview-label blockquote {
	border-left:  2px solid var(--border);
	padding-left: 0.5rem;
	margin:       0.125rem 0;
	font-style:   italic;
	color:        color-mix(in oklch, var(--muted-foreground) 70%, transparent);
}

/* ── Option-row inputs — reset WP admin's input border/bg override ─────── */
#ALLFB-Admin-Root input.option-row-input {
	border:           0 !important;
	background-color: transparent !important;
	box-shadow:       none !important;
	padding:          0 !important;
	line-height:      1.5;
}

/* ── Builder preview: page background ───────────────────────────────────── */
.allfb-preview-bg {
	background-color: #ffffff;
}

/* ── Builder preview: widget panel max-height token ─────────────────────── */
.allfb-preview-panel {
	max-height: var(--allfb-panel-h, 480px);
}

/* ── allfb widget inputs inside admin root ───────────────────────────────── */
/* WP admin CSS (e.g. #wpcontent input[type="text"], spec ≥0,2,1) beats the  */
/* plain .allfb-input class (0,1,0) from frontend.pcss. These ID-scoped rules */
/* (1,1,0 / 1,1,1) win cleanly without !important.                            */
#ALLFB-Admin-Root .allfb-input,
#ALLFB-Admin-Root .allfb-textarea {
	box-sizing:    border-box;
	width:         100%;
	padding:       8px 12px;
	font-size:     13px;
	font-family:   var(--allfb-font);
	line-height:   1.5;
	color:         var(--allfb-text, #1a1a2e);
	background:    color-mix(in srgb, var(--allfb-border, #e5e7eb) 30%, #fff);
	border:        1px solid transparent;
	border-radius: 8px;
	box-shadow:    none;
	outline:       none;
	transition:    border-color 0.15s, background 0.15s, box-shadow 0.15s;
}

#ALLFB-Admin-Root .allfb-input:focus,
#ALLFB-Admin-Root .allfb-textarea:focus {
	border-color: var(--allfb-color, #6366f1);
	background:   #fff;
	box-shadow:   0 0 0 3px color-mix(in srgb, var(--allfb-color, #6366f1) 20%, transparent);
	outline:      none;
}

#ALLFB-Admin-Root .allfb-input.is-error,
#ALLFB-Admin-Root .allfb-textarea.is-error {
	border-color: #dc2626;
	background:   #fff;
	box-shadow:   none;
}

/* ── allfb primary button in admin preview ───────────────────────────────── */
/* WP admin's #wpcontent button rule sits at (1,0,1) and beats the plain      */
/* .allfb-btn--primary selector at (0,1,0). Scope with #ALLFB-Admin-Root to   */
/* reach (1,1,0) and restore the widget accent colour.                        */
#ALLFB-Admin-Root .allfb-btn--primary {
	background:   var(--allfb-color, #6366f1) !important;
	border-color: var(--allfb-color, #6366f1) !important;
	color:        #fff !important;
}

#ALLFB-Admin-Root .allfb-btn--primary:hover:not(:disabled) {
	background:   var(--allfb-color-dark, #4f46e5) !important;
	border-color: var(--allfb-color-dark, #4f46e5) !important;
}

/* ── allfb field error text inside admin root ────────────────────────────── */
/* WP admin p rules can reach (1,1,1)+ specificity — use !important on the   */
/* two properties most likely to be overridden so they match frontend.pcss.  */
#ALLFB-Admin-Root .allfb-field__error {
	font-size:   11px !important;
	font-weight: 400  !important;
	line-height: 1.5;
	color:       #dc2626;
	margin:      0;
	padding:     0;
	min-height:  1em;
}

/* ── allfb field labels inside admin root ────────────────────────────────── */
/* Without the .allfb-widget * reset, WP admin p/em/strong margins leak in.   */
#ALLFB-Admin-Root .allfb-field__label {
	font-size:   13px;
	font-weight: 500;
	color:       var(--allfb-text, #1a1a2e);
	line-height: 1.4;
}

#ALLFB-Admin-Root .allfb-field__label p      { display: inline; margin: 0; padding: 0; }
#ALLFB-Admin-Root .allfb-field__label em,
#ALLFB-Admin-Root .allfb-field__label i      { font-style:  italic; }
#ALLFB-Admin-Root .allfb-field__label strong,
#ALLFB-Admin-Root .allfb-field__label b      { font-weight: 700; }
#ALLFB-Admin-Root .allfb-field__label ul,
#ALLFB-Admin-Root .allfb-field__label ol     { margin: 0; padding-left: 1.25rem; }
#ALLFB-Admin-Root .allfb-field__label li     { margin: 0; }

/* ── Loading cursor while async operations run ───────────────────────────── */
body[data-wait] {
	cursor: wait !important;

	#ALLFB-Admin-Root {
		& button,
		& a,
		& [role='button'] {
			pointer-events: none;
		}
	}
}
