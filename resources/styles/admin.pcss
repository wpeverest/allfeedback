/**
 * admin.pcss — Admin SPA styles
 *
 * Imported by resources/scripts/admin/index.tsx.
 * All rules are scoped under #ALLFB-Admin-Root where possible
 * to prevent WordPress admin CSS from leaking in.
 */

@import './app.pcss';

/* ── Remove WP default content padding so our SPA fills edge-to-edge ─────── */
.toplevel_page_all-feedback #wpcontent,
[class*="_page_all-feedback"] #wpcontent {
	padding-left:  0 !important;
	padding-right: 0 !important;
}

/* ── Neutralise WP admin margins on the React mount point ────────────────── */
#ALLFB-Admin-Root {
	min-height: calc(100vh - var(--wp-admin--admin-bar--height, 32px));
}

/* ── Reset WP global link styles inside the React root ───────────────────── */
#ALLFB-Admin-Root a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

/* ── Focused inputs always use primary colour as border ──────────────────── */
#ALLFB-Admin-Root input:not([type='checkbox']):not([type='radio']):focus,
#ALLFB-Admin-Root select:focus,
#ALLFB-Admin-Root textarea:focus,
#ALLFB-Admin-Root [data-slot='select-trigger']:focus,
#ALLFB-Admin-Root [data-slot='select-trigger']:focus-visible {
	border-color: var(--primary);
	outline:      none;
}

/* ── Override WP admin form styles leaking into shadcn inputs ────────────── */
#ALLFB-Admin-Root [data-slot='input'],
#ALLFB-Admin-Root [data-slot='textarea'],
#ALLFB-Admin-Root [data-slot='select-trigger'],
#ALLFB-Admin-Root input:not([type='checkbox']):not([type='radio']),
#ALLFB-Admin-Root select,
#ALLFB-Admin-Root textarea {
	background-color: var(--card);
	color:            var(--foreground);
	border:           1px solid var(--border);
	box-shadow:       none;
	font-size:        inherit;
	line-height:      1.5;
}

/* ── Fix WP styles leaking into Radix portals ────────────────────────────── */
[data-slot='popover-content'] a,
[data-slot='select-content'] a {
	color:           inherit;
	text-decoration: none;
	box-shadow:      none;
}

[data-slot='select-content'],
[data-slot='select-item'] {
	color:            var(--foreground);
	background-color: var(--card);
	box-shadow:       none;
}

[data-slot='select-item']:hover,
[data-slot='select-item'][data-highlighted] {
	background-color: var(--accent);
	color:            var(--accent-foreground);
	outline:          none;
}

/* ── Remove WP's default button styling inside the SPA ───────────────────── */
#ALLFB-Admin-Root button {
	border:      none;
	appearance:  none;
	margin:      0;
	cursor:      pointer;
	font-size:   14px;
	line-height: 1;
}

/* ── Button size font sizes — mirrors CVA size tokens in button.tsx ────────── */
/* WP admin non-layered CSS beats Tailwind @layer utilities, so we re-apply   */
/* the same values here at higher specificity (1,2,0) > button rule (1,0,1).  */
/* Keep in sync with the `size` variants in button.tsx when those change.     */
#ALLFB-Admin-Root [data-slot='button'][data-size='xs']  { font-size: 12px; } /* text-xs    */
#ALLFB-Admin-Root [data-slot='button'][data-size='sm']  { font-size: 13px; } /* text-[13px] */
#ALLFB-Admin-Root [data-slot='button'][data-size='lg']  { font-size: 15px; } /* text-[15px] */
/* default / icon sizes → 14px from the base button rule above               */

/* ── Pointer cursor on select options ────────────────────────────────────── */
#ALLFB-Admin-Root select option {
	cursor: pointer;
}

/* ── Builder root: establish 14 px font baseline ─────────────────────────── */
.allfb-builder {
	font-size:   14px;
	font-family: var(--font-sans);
	line-height: 1.5;
	color:       var(--foreground);
}

/* ── Builder form title (must come after the input + button reset rules) ──── */
/* Specificity (1,2,1) ties input reset → source-order wins (this rule is later). */
/* Specificity (1,1,1) > button reset (1,0,1) → strict win.                    */
#ALLFB-Admin-Root input.builder-title:not([type='radio']),
#ALLFB-Admin-Root button.builder-title {
	font-size:   18px;
	font-weight: 700;
	line-height: 1.5;
	padding:     0.5rem 0.875rem;
}

/* ── Section title — lock padding + line-height so button and input match ─── */
#ALLFB-Admin-Root input.section-title-input,
#ALLFB-Admin-Root button.section-title-btn {
	line-height: 1.5;
	padding:     0.375rem 0.625rem;
}

/* Give display-mode title buttons the same border box as their edit inputs    */
/* so total height and text position stay identical in both states.             */
#ALLFB-Admin-Root button.builder-title,
#ALLFB-Admin-Root button.section-title-btn {
	border: 1px solid transparent;
}

/* ── Publish split button ─────────────────────────────────────────────────── */
.publish-split {
	gap: 0;
}

/* border-left separator between Publish and chevron (specificity > button reset) */
#ALLFB-Admin-Root .publish-split .publish-split__arrow {
	border-left: 1px solid oklch(1 0 0 / 0.2);
}

/* ── Field type icon chips (data-type colours) ────────────────────────────── */
.field-type-icon {
	display:         flex;
	align-items:     center;
	justify-content: center;
	flex-shrink:     0;
	border-radius:   var(--radius-sm);
}

.field-type-icon[data-type='short_text']      { background-color: #fef2f2; color: #f43f5e; }
.field-type-icon[data-type='long_text']       { background-color: #eff6ff; color: #3b82f6; }
.field-type-icon[data-type='multi_select']    { background-color: #f5f3ff; color: #8b5cf6; }
.field-type-icon[data-type='checkboxes']      { background-color: #f0fdf4; color: #22c55e; }
.field-type-icon[data-type='multiple_choice'] { background-color: #fff1f2; color: #f43f5e; }
.field-type-icon[data-type='star_rating']     { background-color: #fffbeb; color: #f59e0b; }
.field-type-icon[data-type='scale']           { background-color: #ecfdf5; color: #10b981; }
.field-type-icon[data-type='nps']             { background-color: #fff1f2; color: #e11d48; }

/* ── Field type floating menu (positioned by @floating-ui/dom) ────────────── */
/* top/left are set via JS — visibility:hidden until positioned prevents flash */
.field-type-menu {
	position:   fixed;
	top:        0;
	left:       0;
	z-index:    100000;
	width:      248px;
	max-height: calc(100vh - 16px);
	overflow-y: auto;
}

/* ── Preview panel container (dynamic width via CSS custom property) ─────── */
.preview-panel-wrapper {
	width: var(--preview-width, 45vw);
}

/* ── Required field checkbox ──────────────────────────────────────────────── */
#ALLFB-Admin-Root input[type='checkbox'].field-required-checkbox {
	width:        14px;
	height:       14px;
	accent-color: #6366f1 !important; /* --brand-500; !important beats WP admin override */
	cursor:       pointer;
	flex-shrink:  0;
}

/* ── Table typography — mirrors text-sm / text-xs tokens in theme ───────── */
/* WP admin ships its own table CSS; these non-layered rules enforce tokens.  */
#ALLFB-Admin-Root table {
	font-size:   13px; /* text-sm  */
	line-height: 1.5;
}

#ALLFB-Admin-Root th {
	font-size:   11px; /* text-xs  */
	font-weight: 600;
	line-height: 1.5;
}

#ALLFB-Admin-Root td {
	font-size:   13px; /* text-sm  */
	line-height: 1.5;
}

/* ── Tiptap question editor ──────────────────────────────────────────────── */
/* Scope tightly to avoid WP admin global p/strong/em margin/style conflicts  */
#ALLFB-Admin-Root .question-editor-field .tiptap {
	font-size:   15px;
	font-weight: 600;
	color:       var(--foreground);
	outline:     none;
	min-height:  1.75rem;
	line-height: 1.5;
	padding:     0.4rem 0.625rem;
	cursor:      text;
}

/* Strip WP admin's default paragraph margin inside the editor */
#ALLFB-Admin-Root .question-editor-field .tiptap p {
	margin: 0;
}

/* Placeholder text (Tiptap adds .is-editor-empty + data-placeholder) */
#ALLFB-Admin-Root .question-editor-field .tiptap p.is-editor-empty:first-child::before {
	content:        attr(data-placeholder);
	float:          left;
	height:         0;
	pointer-events: none;
	color:          var(--muted-foreground);
	opacity:        0.40;
	font-weight:    600;
}

/* ── Loading cursor while async operations run ───────────────────────────── */
body[data-wait] {
	cursor: wait !important;

	#ALLFB-Admin-Root {
		& button,
		& a,
		& [role='button'] {
			pointer-events: none;
		}
	}
}
