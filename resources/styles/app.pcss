/**
 * app.pcss — Tailwind CSS v4 base + AllFeedback design tokens
 *
 * Imported by both admin.pcss and frontend.pcss.
 *
 * Color palette (indigo/violet brand from design spec):
 *   50  #F8F7FF  100  #F1EFFE  200  #DDD7FD  300  #C0B7FB  400  #9A91F7
 *   500 #6366F1  600  #5556C9  700  #434296  800  #312F65  900  #1F1D39  950 #14111F
 */

@import 'tailwindcss';
@import 'tw-animate-css';

/* ── Dark-mode variant ───────────────────────────────────────────────────── */
@custom-variant dark (&:is(.dark *));

/* ── Design token mapping (Tailwind → CSS variables) ────────────────────── */
@theme inline {
	/* ── Radius scale ────────────────────────────────────────────── */
	--radius-xs:  calc(var(--radius) - 6px);
	--radius-sm:  calc(var(--radius) - 4px);
	--radius-md:  calc(var(--radius) - 2px);
	--radius-lg:  var(--radius);
	--radius-xl:  calc(var(--radius) + 4px);
	--radius-2xl: calc(var(--radius) + 8px);
	--radius-3xl: calc(var(--radius) + 16px);

	/* ── Semantic color aliases ───────────────────────────────────── */
	--color-background:           var(--background);
	--color-foreground:           var(--foreground);
	--color-card:                 var(--card);
	--color-card-foreground:      var(--card-foreground);
	--color-popover:              var(--popover);
	--color-popover-foreground:   var(--popover-foreground);
	--color-primary:              var(--primary);
	--color-primary-foreground:   var(--primary-foreground);
	--color-secondary:            var(--secondary);
	--color-secondary-foreground: var(--secondary-foreground);
	--color-muted:                var(--muted);
	--color-muted-foreground:     var(--muted-foreground);
	--color-accent:               var(--accent);
	--color-accent-foreground:    var(--accent-foreground);
	--color-destructive:          var(--destructive);
	--color-destructive-foreground: var(--destructive-foreground);
	--color-border:               var(--border);
	--color-input:                var(--input);
	--color-ring:                 var(--ring);

	/* ── Brand scale (full 11-stop indigo/violet palette) ─────────── */
	--color-brand-50:  var(--brand-50);
	--color-brand-100: var(--brand-100);
	--color-brand-200: var(--brand-200);
	--color-brand-300: var(--brand-300);
	--color-brand-400: var(--brand-400);
	--color-brand-500: var(--brand-500);
	--color-brand-600: var(--brand-600);
	--color-brand-700: var(--brand-700);
	--color-brand-800: var(--brand-800);
	--color-brand-900: var(--brand-900);
	--color-brand-950: var(--brand-950);

	/* ── Status semantic colors ──────────────────────────────────── */
	--color-success:             var(--success);
	--color-success-foreground:  var(--success-foreground);
	--color-success-subtle:      var(--success-subtle);
	--color-warning:             var(--warning);
	--color-warning-foreground:  var(--warning-foreground);
	--color-warning-subtle:      var(--warning-subtle);
	--color-info:                var(--info);
	--color-info-foreground:     var(--info-foreground);
	--color-info-subtle:         var(--info-subtle);

	/* ── Shadow tokens ───────────────────────────────────────────── */
	--shadow-card: var(--shadow-card-value);
	--shadow-dropdown: var(--shadow-dropdown-value);
}

/* ── Light theme ─────────────────────────────────────────────────────────── */
:root {
	--radius: 0.5rem;

	/* ── Brand scale — indigo/violet (#F8F7FF → #14111F) ─────────── */
	--brand-50:  oklch(0.977 0.013 277);   /* #F8F7FF */
	--brand-100: oklch(0.960 0.027 277);   /* #F1EFFE */
	--brand-200: oklch(0.913 0.058 277);   /* #DDD7FD */
	--brand-300: oklch(0.837 0.099 277);   /* #C0B7FB */
	--brand-400: oklch(0.725 0.165 277);   /* #9A91F7 */
	--brand-500: oklch(0.580 0.238 277);   /* #6366F1 */
	--brand-600: oklch(0.514 0.214 277);   /* #5556C9 */
	--brand-700: oklch(0.427 0.178 277);   /* #434296 */
	--brand-800: oklch(0.326 0.131 277);   /* #312F65 */
	--brand-900: oklch(0.235 0.087 277);   /* #1F1D39 */
	--brand-950: oklch(0.175 0.058 277);   /* #14111F */

	/* ── Neutrals — cool slate ────────────────────────────────────── */
	--background:         #F3F4F6;
	--foreground:         oklch(0.145 0.012 247);
	--card:               oklch(1     0     0);
	--card-foreground:    oklch(0.145 0.012 247);
	--popover:            oklch(1     0     0);
	--popover-foreground: oklch(0.145 0.012 247);
	--muted:              oklch(0.945 0.004 247);
	--muted-foreground:   oklch(0.510 0.010 247);
	--border:             oklch(0.900 0.006 247);
	--input:              oklch(0.900 0.006 247);
	--ring:               var(--brand-500);

	/* ── Primary — indigo 500 ─────────────────────────────────────── */
	--primary:            var(--brand-500);
	--primary-foreground: oklch(0.99  0     0);

	/* ── Secondary — brand-50 tint with brand-700 text ───────────── */
	--secondary:          var(--brand-50);
	--secondary-foreground: var(--brand-700);

	/* ── Accent — brand-100 ───────────────────────────────────────── */
	--accent:             var(--brand-100);
	--accent-foreground:  var(--brand-700);

	/* ── Destructive — red ────────────────────────────────────────── */
	--destructive:        oklch(0.577 0.245 27);
	--destructive-foreground: oklch(0.99 0 0);

	/* ── Status: success ─────────────────────────────────────────── */
	--success:            oklch(0.520 0.150 145);
	--success-foreground: oklch(0.99  0     0);
	--success-subtle:     oklch(0.960 0.040 145);

	/* ── Status: warning ─────────────────────────────────────────── */
	--warning:            oklch(0.720 0.170 75);
	--warning-foreground: oklch(0.20  0.020 75);
	--warning-subtle:     oklch(0.970 0.040 90);

	/* ── Status: info ────────────────────────────────────────────── */
	--info:               oklch(0.555 0.185 245);
	--info-foreground:    oklch(0.99  0     0);
	--info-subtle:        oklch(0.950 0.040 245);

	/* ── Shadows ─────────────────────────────────────────────────── */
	/* card: very subtle ring + minimal lift                         */
	--shadow-card-value:
		0 0 0 1px oklch(0 0 0 / 0.03),
		0 1px 3px oklch(0 0 0 / 0.04);
	--shadow-dropdown-value: 0 4px 16px oklch(0 0 0 / 0.10), 0 1px 4px oklch(0 0 0 / 0.06);
}

/* ── Dark theme ──────────────────────────────────────────────────────────── */
.dark {
	--background:         oklch(0.135 0.020 277);
	--foreground:         oklch(0.970 0.005 247);
	--card:               oklch(0.185 0.025 277);
	--card-foreground:    oklch(0.970 0.005 247);
	--popover:            oklch(0.185 0.025 277);
	--popover-foreground: oklch(0.970 0.005 247);
	--primary:            var(--brand-400);
	--primary-foreground: var(--brand-950);
	--secondary:          oklch(0.240 0.040 277);
	--secondary-foreground: oklch(0.850 0.060 277);
	--muted:              oklch(0.235 0.030 277);
	--muted-foreground:   oklch(0.620 0.018 247);
	--accent:             oklch(0.255 0.050 277);
	--accent-foreground:  var(--brand-300);
	--destructive:        oklch(0.650 0.225 22);
	--destructive-foreground: oklch(0.99 0 0);
	--border:             oklch(1     0     0 / 0.10);
	--input:              oklch(1     0     0 / 0.12);
	--ring:               var(--brand-400);
	--success:            oklch(0.600 0.150 145);
	--success-foreground: oklch(0.12  0     0);
	--success-subtle:     oklch(0.240 0.060 145);
	--warning:            oklch(0.750 0.170 75);
	--warning-foreground: oklch(0.12  0     0);
	--warning-subtle:     oklch(0.250 0.060 75);
	--info:               oklch(0.620 0.185 245);
	--info-foreground:    oklch(0.12  0     0);
	--info-subtle:        oklch(0.240 0.060 245);

	--shadow-card-value:
		0 0 0 1px oklch(0 0 0 / 0.12),
		0 1px 3px oklch(0 0 0 / 0.15);
	--shadow-dropdown-value: 0 4px 16px oklch(0 0 0 / 0.40), 0 1px 4px oklch(0 0 0 / 0.25);
}

/* ── Typography ──────────────────────────────────────────────────────────── */
@theme inline {
	/* Font family */
	--font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;

	/* Font size scale with line-height */
	--text-xs:   0.75rem;    /* 12px — captions, labels */
	--text-sm:   0.8125rem;  /* 13px — body small */
	--text-base: 0.875rem;   /* 14px — body default */
	--text-md:   1rem;       /* 16px — body large */
	--text-lg:   1.125rem;   /* 18px — heading small */
	--text-xl:   1.25rem;    /* 20px — heading medium */
	--text-2xl:  1.5rem;     /* 24px — heading large */
	--text-3xl:  1.875rem;   /* 30px — display */

	/* Font weights */
	--font-weight-normal:   400;
	--font-weight-medium:   500;
	--font-weight-semibold: 600;
	--font-weight-bold:     700;
	--font-weight-extrabold: 800;
}

/* ── Base resets ─────────────────────────────────────────────────────────── */
@layer base {
	* {
		@apply border-border outline-ring/50;
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-sans);
		font-size: 14px;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		@apply bg-background text-foreground;
		font-weight: 400;
		line-height: 1.5;
	}

	h1, h2, h3, h4, h5, h6 {
		font-weight: 600;
		line-height: 1.3;
		color: var(--foreground);
	}

	/* Consistent focus ring */
	:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}
}
