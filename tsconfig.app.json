{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target":          "ES2023",
    "useDefineForClassFields": true,
    "lib":             ["ES2023", "DOM", "DOM.Iterable"],
    "module":          "ESNext",
    "skipLibCheck":    true,

    /* Bundler mode — webpack resolves modules, not tsc */
    "moduleResolution":       "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax":   true,
    "moduleDetection":        "force",
    "noEmit":                 true,
    "jsx":                    "react-jsx",

    /* Strict type-checking */
    "strict":                      true,
    "noUnusedLocals":              true,
    "noUnusedParameters":          true,
    "erasableSyntaxOnly":          true,
    "noFallthroughCasesInSwitch":  true,
    "noUncheckedSideEffectImports":true,
    "resolveJsonModule":           true,

    /* Path aliases — must match webpack.config.js resolve.alias */
    "baseUrl": ".",
    "paths": {
      "@/*":           ["resources/scripts/*"],
      "@components/*": ["resources/scripts/components/*"],
      "@hooks/*":      ["resources/scripts/hooks/*"],
      "@lib/*":        ["resources/scripts/lib/*"]
    }
  },
  "include": ["resources/scripts"]
}
